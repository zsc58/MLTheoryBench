{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contribution Formalization Bundle (Revised Triage)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "resolution", "analysis", "files", "self_audit", "stop_reason"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["formalized", "filtered_out", "stopped"]
    },
    "resolution": {
      "type": "string",
      "enum": ["initial", "formalization_error_fixed", "invalid_objection", "paper_issue_suspected"]
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_contribution",
        "selection_evidence",
        "source_result_labels",
        "proof_closure",
        "proof_outline",
        "paper_type",
        "theory_auxiliary_subtype",
        "triage_reasoning",
        "difficulty",
        "proof_difficulty_level",
        "benchmark_suitability",
        "scope_assessment",
        "difficulty_fidelity"
      ],
      "properties": {
        "principal_contribution": {"type": ["string", "null"]},
        "selection_evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_result_labels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "proof_closure": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "role", "summary", "source_spans", "reason"],
            "properties": {
              "item_id": {"type": "string", "pattern": "^closure_[0-9]{3}$"},
              "role": {
                "type": "string",
                "enum": ["target_claim", "material_internal", "technical_internal", "definition", "external_standard", "excluded_nonmaterial"]
              },
              "summary": {"type": "string", "minLength": 1},
              "source_spans": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "proof_outline": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "paper_type": {
          "type": "string",
          "enum": ["empirical_or_method_only", "theory_auxiliary", "theory_core"]
        },
        "theory_auxiliary_subtype": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["representative", "complete_closure", "generic"],
          "properties": {
            "representative": {"type": "boolean"},
            "complete_closure": {"type": "boolean"},
            "generic": {"type": "boolean"}
          }
        },
        "triage_reasoning": {"type": "string", "minLength": 1},
        "difficulty": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["conceptual_insight", "dependency_depth", "technical_lemma_burden", "closure_difficulty", "compressibility", "total"],
          "properties": {
            "conceptual_insight": {"type": "integer", "minimum": 0, "maximum": 2},
            "dependency_depth": {"type": "integer", "minimum": 0, "maximum": 2},
            "technical_lemma_burden": {"type": "integer", "minimum": 0, "maximum": 2},
            "closure_difficulty": {"type": "integer", "minimum": 0, "maximum": 2},
            "compressibility": {"type": "integer", "minimum": 0, "maximum": 2},
            "total": {"type": "integer", "minimum": 0, "maximum": 10}
          }
        },
        "proof_difficulty_level": {
          "type": ["string", "null"],
          "enum": [null, "D0", "D1", "D2", "D3", "D4"]
        },
        "benchmark_suitability": {
          "type": ["string", "null"],
          "enum": [null, "reject", "baseline", "primary", "stress"]
        },
        "scope_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fits_output_budget", "estimated_answer_tokens", "reason"],
          "properties": {
            "fits_output_budget": {"type": "boolean"},
            "estimated_answer_tokens": {"type": "integer", "minimum": 0},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "difficulty_fidelity": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["hardest_material_obligation", "hardest_obligation_preserved", "removed_as_standard", "removed_as_nonmaterial", "new_burdens", "relative_difficulty", "reason"],
          "properties": {
            "hardest_material_obligation": {"type": ["string", "null"]},
            "hardest_obligation_preserved": {"type": "boolean"},
            "removed_as_standard": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "removed_as_nonmaterial": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "new_burdens": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "relative_difficulty": {
              "type": "string",
              "enum": ["easier", "comparable", "harder", "not_applicable"]
            },
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "files": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_md", "proof_ground_truth_md", "rubric_md", "provenance"],
          "properties": {
            "task_md": {"type": "string", "minLength": 1},
            "proof_ground_truth_md": {"type": "string", "minLength": 1},
            "rubric_md": {"type": "string", "minLength": 1},
            "provenance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items", "notation_map", "source_repairs"],
              "properties": {
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["item_id", "public_element", "kind", "source_spans", "source_section", "source_page", "source_version", "transformation", "justification"],
                    "properties": {
                      "item_id": {"type": "string", "pattern": "^prov_[0-9]{3}$"},
                      "public_element": {"type": "string", "minLength": 1},
                      "kind": {
                        "type": "string",
                        "enum": ["definition", "primitive_assumption", "target", "standard_background", "material_proof_obligation"]
                      },
                      "source_spans": {
                        "type": "array",
                        "items": {"type": "string", "minLength": 1}
                      },
                      "source_section": {"type": ["string", "null"]},
                      "source_page": {"type": ["string", "null"]},
                      "source_version": {"type": ["string", "null"]},
                      "transformation": {
                        "type": "string",
                        "enum": ["exact", "notation_only", "reordered", "equivalent_restatement", "standard_background"]
                      },
                      "justification": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "notation_map": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source", "public"],
                    "properties": {
                      "source": {"type": "string", "minLength": 1},
                      "public": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "source_repairs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["repair_id", "kind", "original_clause_or_step", "local_repair", "source_spans", "claim_preserved", "proof_architecture_preserved", "justification"],
                    "properties": {
                      "repair_id": {"type": "string", "pattern": "^repair_[0-9]{3}$"},
                      "kind": {"type": "string", "enum": ["statement", "proof"]},
                      "original_clause_or_step": {"type": "string", "minLength": 1},
                      "local_repair": {"type": "string", "minLength": 1},
                      "source_spans": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "claim_preserved": {"type": "boolean"},
                      "proof_architecture_preserved": {"type": "boolean"},
                      "justification": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "self_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_integrity", "self_containment", "source_fidelity", "anti_leakage", "contribution_fidelity", "difficulty_fidelity", "validity", "scope", "source_audit", "findings"],
      "properties": {
        "definition_integrity": {"$ref": "#/$defs/audit_item"},
        "self_containment": {"$ref": "#/$defs/audit_item"},
        "source_fidelity": {"$ref": "#/$defs/audit_item"},
        "anti_leakage": {"$ref": "#/$defs/audit_item"},
        "contribution_fidelity": {"$ref": "#/$defs/audit_item"},
        "difficulty_fidelity": {"$ref": "#/$defs/audit_item"},
        "validity": {"$ref": "#/$defs/audit_item"},
        "scope": {"$ref": "#/$defs/audit_item"},
        "source_audit": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["statement_status", "statement_reason", "statement_source_spans", "proof_status", "proof_reason", "proof_source_spans", "combined_status"],
          "properties": {
            "statement_status": {"type": "string", "enum": ["clean", "minor_issue", "major_issue"]},
            "statement_reason": {"type": "string", "minLength": 1},
            "statement_source_spans": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "proof_status": {"type": "string", "enum": ["clean", "minor_error", "major_gap"]},
            "proof_reason": {"type": "string", "minLength": 1},
            "proof_source_spans": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "combined_status": {"type": "string", "enum": ["clean", "minor_source_issue_fixed", "paper_issue_suspected"]}
          }
        },
        "findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [null, "paper_not_theory_core", "paper_too_weak", "paper_issue_suspected", "formalization_not_self_containable", "scope_too_large", "failed_after_max_revisions"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "formalized"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "analysis": {
            "properties": {
              "difficulty": {"type": "object"},
              "proof_difficulty_level": {"type": "string"},
              "benchmark_suitability": {"type": "string"},
              "difficulty_fidelity": {"type": "object"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "analysis": {
            "properties": {
              "difficulty": {"type": "null"},
              "proof_difficulty_level": {"type": "null"},
              "benchmark_suitability": {"type": "null"},
              "difficulty_fidelity": {"type": "null"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "audit_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "fail", "not_applicable"]},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  }
}
