{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed-Task ML Theory Proof Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "verdict",
    "validity_review_resolution",
    "core_step_evaluations",
    "added_core_steps",
    "assumption_and_tool_checks",
    "mathematical_errors",
    "alternative_proof",
    "justification"
  ],
  "properties": {
    "score": {"type": "integer", "minimum": 0, "maximum": 10},
    "verdict": {
      "type": "string",
      "enum": [
        "fully_correct",
        "minor_repair",
        "substantial_partial_progress",
        "minimal_progress",
        "incorrect"
      ]
    },
    "validity_review_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_status", "final_status", "finding_resolutions"],
      "properties": {
        "initial_status": {
          "type": "string",
          "enum": ["valid_complete", "valid_with_minor_issue", "incomplete_major_gap"]
        },
        "final_status": {
          "type": "string",
          "enum": ["valid_complete", "valid_with_minor_issue", "incomplete_major_gap"]
        },
        "finding_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "resolution", "final_severity", "reason"],
            "properties": {
              "finding_id": {"type": "string"},
              "resolution": {
                "type": "string",
                "enum": ["confirmed", "downgraded", "dismissed"]
              },
              "final_severity": {"type": "string", "enum": ["major", "minor", "none"]},
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "core_step_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "step",
          "origin",
          "depends_on",
          "points_available",
          "points_awarded",
          "conclusion_status",
          "proof_status",
          "credit",
          "dependency_analysis",
          "reason"
        ],
        "properties": {
          "step_id": {"type": "string"},
          "step": {"type": "string"},
          "origin": {
            "type": "string",
            "enum": ["independent_review", "rubric", "evaluator_added"]
          },
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "points_available": {"type": "integer", "minimum": 0, "maximum": 10},
          "points_awarded": {"type": "integer", "minimum": 0, "maximum": 10},
          "conclusion_status": {
            "type": "string",
            "enum": ["correct", "incorrect", "uncertain", "not_applicable"]
          },
          "proof_status": {
            "type": "string",
            "enum": ["correct", "partial", "incorrect", "missing", "not_applicable"]
          },
          "credit": {"type": "string", "enum": ["full", "partial", "none"]},
          "dependency_analysis": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "added_core_steps": {"type": "array", "items": {"type": "string"}},
    "assumption_and_tool_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "source", "status", "reason"],
        "properties": {
          "item": {"type": "string"},
          "source": {
            "type": "string",
            "enum": ["task", "proof_derived", "local_conditional", "unsupported", "not_used"]
          },
          "status": {"type": "string", "enum": ["valid", "invalid", "missing", "not_used"]},
          "reason": {"type": "string"}
        }
      }
    },
    "mathematical_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "severity", "description", "repairability"],
        "properties": {
          "location": {"type": "string"},
          "severity": {"type": "string", "enum": ["minor", "major"]},
          "description": {"type": "string"},
          "repairability": {"type": "string"}
        }
      }
    },
    "alternative_proof": {"type": "boolean"},
    "justification": {"type": "string"}
  }
}
