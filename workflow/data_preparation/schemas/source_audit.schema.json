{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 3 Theorem Source Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "material_records"],
  "properties": {
    "status": {"type": "string", "const": "audited"},
    "material_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/material_record"}
    }
  },
  "$defs": {
    "material_id": {
      "type": "string",
      "pattern": "^theory_[0-9]{3}$"
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_source",
        "repaired_form",
        "source_evidence",
        "justification"
      ],
      "properties": {
        "original_source": {"type": "string", "minLength": 1},
        "repaired_form": {"type": "string", "minLength": 1},
        "source_evidence": {"type": "string", "minLength": 1},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line", "label"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "material_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "role",
        "source_label",
        "recovered_content",
        "proof_reconstruction",
        "statement_status",
        "statement_findings",
        "statement_repair",
        "proof_status",
        "proof_findings",
        "proof_repair",
        "external_classification",
        "source_spans",
        "statement_source_locations",
        "proof_source_locations",
        "depends_on",
        "is_added",
        "addition_reason"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/material_id"},
        "role": {
          "type": "string",
          "enum": [
            "theory_candidate",
            "internal_support",
            "definition",
            "external"
          ]
        },
        "source_label": {"type": "string", "minLength": 1},
        "recovered_content": {"type": "string", "minLength": 1},
        "proof_reconstruction": {"type": ["string", "null"], "minLength": 1},
        "statement_status": {
          "type": ["string", "null"],
          "enum": [null, "clean", "minor_issue", "major_issue"]
        },
        "statement_findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "statement_repair": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repair"}
          ]
        },
        "proof_status": {
          "type": ["string", "null"],
          "enum": [null, "clean", "minor_error", "major_gap"]
        },
        "proof_findings": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "proof_repair": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repair"}
          ]
        },
        "external_classification": {
          "type": ["string", "null"],
          "enum": [null, "standard_independent", "nonstandard_dependency"]
        },
        "source_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "statement_source_locations": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_location"}
        },
        "proof_source_locations": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_location"}
        },
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/material_id"}
        },
        "is_added": {"type": "boolean"},
        "addition_reason": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
