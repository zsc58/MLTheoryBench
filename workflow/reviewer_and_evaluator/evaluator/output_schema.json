{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ML Theory Proof Reference Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_status",
    "score",
    "verdict",
    "validity_review_resolution",
    "core_step_evaluations",
    "added_core_steps",
    "assumption_and_tool_checks",
    "mathematical_errors",
    "alternative_proof",
    "justification",
    "artifact_assessment",
    "reference_issue",
    "needs_human_review",
    "human_review_reason"
  ],
  "properties": {
    "evaluation_status": {
      "type": "string",
      "enum": ["scored", "unscorable"]
    },
    "score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 10
    },
    "verdict": {
      "type": "string",
      "enum": [
        "fully_correct",
        "minor_repair",
        "substantial_partial_progress",
        "minimal_progress",
        "incorrect",
        "unscorable_target_error"
      ]
    },
    "validity_review_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_status", "final_status", "finding_resolutions"],
      "properties": {
        "initial_status": {
          "type": "string",
          "enum": [
            "valid_complete",
            "valid_with_minor_issue",
            "incomplete_major_gap",
            "target_suspected_invalid"
          ]
        },
        "final_status": {
          "type": "string",
          "enum": [
            "valid_complete",
            "valid_with_minor_issue",
            "incomplete_major_gap",
            "target_invalid"
          ]
        },
        "finding_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "resolution",
              "final_severity",
              "reason"
            ],
            "properties": {
              "finding_id": {"type": "string"},
              "resolution": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "downgraded",
                  "dismissed",
                  "accepted_task_alternative"
                ]
              },
              "final_severity": {
                "type": "string",
                "enum": ["blocking", "major", "minor", "none"]
              },
              "reason": {"type": "string"}
            }
          }
        }
      }
    },
    "core_step_evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "step",
          "origin",
          "depends_on",
          "points_available",
          "points_awarded",
          "conclusion_status",
          "proof_status",
          "credit",
          "dependency_analysis",
          "reason"
        ],
        "properties": {
          "step_id": {"type": "string"},
          "step": {"type": "string"},
          "origin": {
            "type": "string",
            "enum": ["independent_review", "rubric", "evaluator_added"]
          },
          "depends_on": {
            "type": "array",
            "items": {"type": "string"}
          },
          "points_available": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "points_awarded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "conclusion_status": {
            "type": "string",
            "enum": ["correct", "incorrect", "uncertain", "not_applicable"]
          },
          "proof_status": {
            "type": "string",
            "enum": ["correct", "partial", "incorrect", "missing", "not_applicable"]
          },
          "credit": {
            "type": "string",
            "enum": ["full", "partial", "none"]
          },
          "dependency_analysis": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "added_core_steps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumption_and_tool_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "source", "status", "reason"],
        "properties": {
          "item": {"type": "string"},
          "source": {
            "type": "string",
            "enum": [
              "task",
              "proof_derived",
              "local_conditional",
              "unsupported",
              "not_used"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["valid", "invalid", "missing", "not_used"]
          },
          "reason": {"type": "string"}
        }
      }
    },
    "mathematical_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "severity", "description", "repairability"],
        "properties": {
          "location": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["minor", "major", "fatal"]
          },
          "description": {"type": "string"},
          "repairability": {"type": "string"}
        }
      }
    },
    "alternative_proof": {"type": "boolean"},
    "justification": {"type": "string"},
    "artifact_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_task_status",
        "ground_truth_status",
        "source_theorem_status",
        "scoring_basis",
        "repairs"
      ],
      "properties": {
        "public_task_status": {
          "type": "string",
          "enum": [
            "clean",
            "minor_typo",
            "repairable_formalization_error",
            "material_target_error"
          ]
        },
        "ground_truth_status": {
          "type": "string",
          "enum": [
            "not_provided",
            "clean",
            "minor_issue",
            "repairable_error",
            "material_error"
          ]
        },
        "source_theorem_status": {
          "type": "string",
          "enum": ["not_assessed", "appears_valid", "suspected_error"]
        },
        "scoring_basis": {
          "type": "string",
          "enum": ["task_as_written", "locally_repaired_task", "unscorable"]
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact",
              "problem",
              "repair",
              "changes_mathematical_content",
              "score_effect"
            ],
            "properties": {
              "artifact": {
                "type": "string",
                "enum": ["public_task", "private_ground_truth", "source_theorem"]
              },
              "problem": {"type": "string"},
              "repair": {"type": "string"},
              "changes_mathematical_content": {"type": "boolean"},
              "score_effect": {"type": "string"}
            }
          }
        }
      }
    },
    "reference_issue": {
      "type": "string",
      "enum": [
        "none",
        "repairable_task_formalization_error",
        "repairable_ground_truth_error",
        "repairable_core_step_omission",
        "unrepairable_target_error"
      ]
    },
    "needs_human_review": {"type": "boolean"},
    "human_review_reason": {
      "type": ["string", "null"]
    }
  }
}
