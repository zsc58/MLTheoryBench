{
  "schema_version": "1.0",
  "agent": {
    "model": "gpt-6-astra",
    "reasoning_effort": "high",
    "provider": "get-api"
  },
  "providers": {
    "get-api": {"base_url": "https://api.get-apikey.com/v1"},
    "novita": {"base_url": "https://api.novita.ai/anthropic"}
  },
  "defaults": {
    "max_output_tokens": 48000,
    "timeout_seconds": 3600,
    "stream": true
  },
  "modes": {
    "formal": ["gpt6", "gpt56", "claude_fable", "deepseek_pro", "glm53", "kimi_k3", "qwen38_max"],
    "test": ["gpt6", "gpt56"]
  },
  "solvers": {
    "gpt6": {"provider": "get-api", "model": "gpt-6-astra", "wire_api": "responses", "reasoning_effort": "high"},
    "gpt56": {"provider": "get-api", "model": "gpt-5.6-sol", "wire_api": "responses", "reasoning_effort": "high"},
    "claude_fable": {"provider": "novita", "model": "pa/claude-fable-5", "wire_api": "anthropic_messages", "reasoning_effort": "high"},
    "deepseek_pro": {"provider": "get-api", "model": "deepseek-v4-pro", "wire_api": "chat_completions", "reasoning_effort": "high", "chat_token_limit_parameter": "max_completion_tokens"},
    "glm53": {"provider": "get-api", "model": "glm-5.3", "wire_api": "chat_completions", "reasoning_effort": "high"},
    "kimi_k3": {"provider": "get-api", "model": "kimi-k3", "wire_api": "chat_completions", "reasoning_effort": "high"},
    "qwen38_max": {"provider": "get-api", "model": "qwen3.8-max", "wire_api": "chat_completions", "reasoning_effort": "high", "chat_token_limit_parameter": "max_completion_tokens"}
  }
}
