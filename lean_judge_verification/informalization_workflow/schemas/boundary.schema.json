{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["case_id", "target", "expanded_obligations", "background_lemmas", "context_groups", "files_read", "limitations"],
  "properties": {
    "case_id": {"type": "string"}, "target": {"type": "string"},
    "expanded_obligations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "background_lemmas": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "interface", "kind", "lean_declarations", "source_refs", "reason"],
      "properties": {
        "id": {"type": "string"}, "interface": {"type": "string"},
        "kind": {"enum": ["general_background", "permitted_project_result"]},
        "lean_declarations": {"$ref": "#/$defs/names"},
        "source_refs": {"$ref": "#/$defs/refs"}, "reason": {"type": "string"}
      }
    }},
    "context_groups": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["lean_declarations", "reason"],
      "properties": {"lean_declarations": {"$ref": "#/$defs/names"}, "reason": {"type": "string"}}
    }},
    "files_read": {"$ref": "#/$defs/names"}, "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "strings": {"type": "array", "items": {"type": "string"}},
    "refs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "start_line", "end_line", "declaration"],
      "properties": {"file": {"type": "string"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "declaration": {"type": "string"}}
    }}
  }
}
