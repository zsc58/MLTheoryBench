{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["case_id", "target_node", "nodes", "background_ids", "scope_coverage", "limitations"],
  "properties": {
    "case_id": {"type": "string"}, "target_node": {"type": "string"},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "role", "lean_declarations", "summary", "depends_on", "source_refs"],
      "properties": {"id": {"type": "string"}, "role": {"enum": ["target", "expanded"]}, "lean_declarations": {"$ref": "#/$defs/strings"}, "summary": {"type": "string"}, "depends_on": {"$ref": "#/$defs/strings"}, "source_refs": {"$ref": "#/$defs/refs"}}}},
    "background_ids": {"$ref": "#/$defs/strings"},
    "scope_coverage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["obligation", "node_ids"], "properties": {"obligation": {"type": "string"}, "node_ids": {"$ref": "#/$defs/strings"}}}},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"strings": {"type": "array", "items": {"type": "string"}}, "refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["file", "start_line", "end_line", "declaration"], "properties": {"file": {"type": "string"}, "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "declaration": {"type": "string"}}}}}
}
