{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "propagation_audit.schema.json",
  "title": "PaperProof Targeted Downstream Propagation Audit",
  "description": "One paper-level turn that traces validated source findings and their honest repairs into unmarked downstream theory candidates without auditing new errors or theorem failure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["downstream_assessments"],
  "properties": {
    "downstream_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/downstreamAssessment"}
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/location"}
    },
    "propagatedResultImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_impact_level",
        "revised_result_summary",
        "impact_explanation",
        "primary_driver_finding_id"
      ],
      "properties": {
        "result_impact_level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 4
        },
        "revised_result_summary": {"type": "string", "minLength": 1},
        "impact_explanation": {"type": "string", "minLength": 1},
        "primary_driver_finding_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "downstreamAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "downstream_result_id",
        "upstream_finding_ids",
        "affected_interface",
        "use_locations",
        "propagation_status",
        "propagated_result_impact_assessment",
        "open_questions"
      ],
      "properties": {
        "downstream_result_id": {"type": "string", "minLength": 1},
        "upstream_finding_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "affected_interface": {"type": "string", "minLength": 1},
        "use_locations": {"$ref": "#/$defs/locations"},
        "propagation_status": {
          "enum": [
            "unaffected_interface_not_used",
            "survives_under_selected_repair",
            "contract_narrowed",
            "conclusion_weakened",
            "proof_support_lost",
            "indeterminate"
          ]
        },
        "propagated_result_impact_assessment": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/propagatedResultImpact"}
          ]
        },
        "open_questions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
